# ==========================================
# Revive AI — Environment Configuration
# ==========================================

# 1. LLM Autonomous Decision Brain (Choose Gemini or OpenAI)
# Recommended: Google Gemini 1.5 Flash (Free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Alternative: OpenAI GPT-4o-mini (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# 2. Razorpay Payment Gateway & Webhook Credentials
# Generate in Razorpay Dashboard -> Settings -> API Keys (Test Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Webhook Secret configured in Razorpay Dashboard -> Webhooks
# Target URL: https://your-deployment.vercel.app/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# 3. Server Configuration
PORT=3001
NODE_ENV=production
